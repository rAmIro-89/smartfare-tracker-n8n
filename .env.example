## SerpAPI Google Flights configuration (example)
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_ENGINE=google_flights
DEFAULT_ORIGIN=EZE
DEFAULT_DESTINATION=YWG
DEFAULT_CURRENCY=USD
DEFAULT_MAX_PRICE=900
DEFAULT_MAX_STOPS=2
DEFAULT_MAX_DURATION_MINUTES=1500

# Do not commit real API keys or secrets. Store them in n8n credentials or local .env files excluded by .gitignore.
# Optional environment variables for future deployment

GENERIC_TIMEZONE=America/Argentina/Buenos_Aires
TZ=America/Argentina/Buenos_Aires
FLIGHT_API_PROVIDER=aviationstack
FLIGHT_API_KEY=AVIATIONSTACK_API_KEY
FLIGHT_API_SECRET=
FLIGHT_API_BASE_URL=http://api.aviationstack.com/v1
# Do not commit real tokens or secrets.
