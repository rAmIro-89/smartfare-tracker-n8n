# Optional environment variables for future deployment

GENERIC_TIMEZONE=America/Argentina/Buenos_Aires
TZ=America/Argentina/Buenos_Aires

# Ollama local LLM configuration
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_PROMPT_FILE=prompts/flight-decision-prompt.md
OLLAMA_INPUT_FILE=examples/ollama-flight-request.json

# SerpAPI configuration for Google Flights search
SERPAPI_API_KEY=
SERPAPI_ENGINE=google_flights
SERPAPI_DEPARTURE_ID=EZE
SERPAPI_ARRIVAL_ID=YWG
SERPAPI_OUTBOUND_DATE=2026-08-01
SERPAPI_TYPE=2
SERPAPI_CURRENCY=USD
SERPAPI_HL=en
GOOGLE_SHEETS_DOCUMENT_ID=

# Google Sheets and Telegram credentials are stored inside n8n.
# Keep these values empty in the repo and configure the real ones in n8n.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Do not commit real tokens or secrets.
