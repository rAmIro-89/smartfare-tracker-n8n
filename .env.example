# SerpAPI Google Flights configuration (example)
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_ENGINE=google_flights
SERPAPI_DEPARTURE_ID=EZE
SERPAPI_ARRIVAL_ID=YWG
SERPAPI_OUTBOUND_DATE=
SERPAPI_TYPE=2
SERPAPI_CURRENCY=USD
SERPAPI_HL=en
SERPAPI_GL=us
DEFAULT_MAX_PRICE=900
DEFAULT_MAX_STOPS=2
DEFAULT_MAX_DURATION_MINUTES=1500

# Do not commit real API keys or secrets. Store them in n8n credentials or local .env files excluded by .gitignore.
