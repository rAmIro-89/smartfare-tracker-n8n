    {
      "parameters": {
        "jsCode": "const config = $json;\n\nconst bestFlights = $json.best_flights || [];\nconst otherFlights = $json.other_flights || [];\n\nconst allFlights = [...bestFlights, ...otherFlights];\n\nreturn allFlights.map(option => {\n  const segments = option.flights || [];\n  const firstSegment = segments[0] || {};\n  const lastSegment = segments[segments.length - 1] || {};\n\n  return {\n    json: {\n      user_name: config.user_name,\n      telegram_chat_id: config.telegram_chat_id,\n      max_price: Number(config.max_price),\n      excellent_price: Number(config.excellent_price),\n      max_stops: Number(config.max_stops),\n      max_duration_minutes: Number(config.max_duration_minutes),\n      alert_threshold: Number(config.alert_threshold),\n\n      timestamp: new Date().toISOString(),\n      provider: \"SerpAPI Google Flights\",\n      origin: firstSegment.departure_airport?.id || null,\n      destination: lastSegment.arrival_airport?.id || null,\n      airline: firstSegment.airline || null,\n      flight_number: firstSegment.flight_number || null,\n      departure_time: firstSegment.departure_airport?.time || null,\n      arrival_time: lastSegment.arrival_airport?.time || null,\n      duration_minutes: option.total_duration || null,\n      stops: segments.length > 0 ? segments.length - 1 : null,\n      layovers: segments\n        .slice(0, -1)\n        .map(segment => segment.arrival_airport?.id)\n        .filter(Boolean),\n      layovers_text: segments\n        .slice(0, -1)\n        .map(segment => segment.arrival_airport?.id)\n        .filter(Boolean)\n        .join(\" → \"),\n      price: option.price || null,\n      currency: config.currency || \"USD\",\n      alert_type: \"Real fare search result\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        -160
      ],
      "id": "ad1ec49e-5044-439e-9352-af1a5a2b8b00",
      "name": "Normalize SerApi Response",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const flight = item.json;\n\n  const maxPrice = Number(flight.max_price);\n  const maxStops = Number(flight.max_stops);\n  const maxDuration = Number(flight.max_duration_minutes);\n  const threshold = Number(flight.alert_threshold);\n\n  let score = 100;\n  const reasons = [];\n\n  if (flight.price > maxPrice) {\n    score -= 40;\n    reasons.push(`Price above preferred budget (${flight.price} > ${maxPrice})`);\n  }\n\n  if (flight.stops > maxStops) {\n    score -= 20;\n    reasons.push(`Too many stops (${flight.stops} > ${maxStops})`);\n  }\n\n  if (flight.duration_minutes > maxDuration) {\n    score -= 30;\n    reasons.push(`Duration exceeds preferred maximum (${flight.duration_minutes} > ${maxDuration})`);\n  }\n\n  score = Math.max(0, Math.min(100, score));\n\n  return {\n    json: {\n      ...flight,\n      score,\n      alert: score >= threshold,\n      scoring_reasons: reasons\n    }\n  };\n});"
      },
