    {
      "parameters": {
        "jsCode": "function normalizeDate(value) {\n  const raw = String(value || \"\").trim();\n\n  // Si ya viene YYYY-MM-DD, lo dejamos igual\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(raw)) {\n    return raw;\n  }\n\n  // Convierte D/MM/YYYY o DD/MM/YYYY a YYYY-MM-DD\n  const match = raw.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/);\n  if (match) {\n    const day = match[1].padStart(2, \"0\");\n    const month = match[2].padStart(2, \"0\");\n    const year = match[3];\n    return `${year}-${month}-${day}`;\n  }\n\n  return raw;\n}\n\nreturn items.map(item => {\n  const row = item.json;\n\n  const enabledRaw = String(row[\"Enable Flight Alerts\"] || \"\").trim().toLowerCase();\n\n  return {\n    json: {\n      enabled: enabledRaw === \"yes\",\n      user_name: row[\"User Name\"],\n      telegram_chat_id: row[\"Telegram Chat ID\"],\n      origin: String(row[\"Origin Airport\"] || \"\").trim().toUpperCase(),\n      destination: String(row[\"Destination Airport\"] || \"\").trim().toUpperCase(),\n      outbound_date: normalizeDate(row[\"Outbound Date\"]),\n      max_price: Number(row[\"Maximum Price (USD)\"]),\n      excellent_price: Math.round(Number(row[\"Maximum Price (USD)\"]) * 0.85),\n      max_stops: Number(row[\"Maximum Stops\"]),\n      max_duration_minutes: 1500,\n      alert_threshold: Number(row[\"Alert Threshold\"]) || 75,\n      currency: \"USD\",\n      source: \"google_form\"\n    }\n  };\n});"
      },
