      "parameters": {
        "jsCode": "return items.map(item => {\n  const raw = item.json.content || item.json.response || \"\";\n\n  const cleaned = String(raw)\n    .replace(/^```json\\s*/i, \"\")\n    .replace(/^```\\s*/i, \"\")\n    .replace(/```$/i, \"\")\n    .trim();\n\n  let parsed;\n\n  try {\n    parsed = JSON.parse(cleaned);\n  } catch (error) {\n    parsed = {\n      reason: cleaned,\n      pros: [],\n      cons: [\"Could not parse Ollama response as JSON\"]\n    };\n  }\n\n  return {\n    json: parsed\n  };\n});"
      },
