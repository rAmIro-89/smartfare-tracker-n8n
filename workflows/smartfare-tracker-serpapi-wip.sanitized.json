{
    "name": "smartfare-tracker-serpapi-wip",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "hours",
                            "hoursInterval": 6
                        }
                    ]
                }
            },
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.3,
            "position": [
                -192,
                -128
            ],
            "id": "sched-1",
            "name": "Schedule Trigger"
        },
        {
            "parameters": {
                "url": "SERPAPI_BASE_URL",
                "sendQuery": true,
                "queryParameters": {
                    "parameters": [
                        {
                            "name": "engine",
                            "value": "SERPAPI_ENGINE"
                        },
                        {
                            "name": "api_key",
                            "value": "SERPAPI_API_KEY"
                        },
                        {
                            "name": "departure_id",
                            "value": "SERPAPI_DEPARTURE_ID"
                        },
                        {
                            "name": "arrival_id",
                            "value": "SERPAPI_ARRIVAL_ID"
                        },
                        {
                            "name": "outbound_date",
                            "value": "SERPAPI_OUTBOUND_DATE"
                        },
                        {
                            "name": "type",
                            "value": "SERPAPI_TYPE"
                        },
                        {
                            "name": "currency",
                            "value": "SERPAPI_CURRENCY"
                        },
                        {
                            "name": "hl",
                            "value": "SERPAPI_HL"
                        },
                        {
                            "name": "gl",
                            "value": "SERPAPI_GL"
                        }
                    ]
                },
                "options": {}
            },
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.4,
            "position": [
                80,
                -128
            ],
            "id": "http-1",
            "name": "HTTP Request"
        },
        {
            "parameters": {
                "jsCode": "const resultSets = [$json.best_flights || [], $json.other_flights || [], $json.search_results || []].flat();\nconst flights = resultSets.length ? resultSets : [$json];\n\nreturn flights.map(item => ({\n  json: {\n    timestamp: new Date().toISOString(),\n    origin: item.departure_id || item.origin || 'EZE',\n    destination: item.arrival_id || item.destination || 'YWG',\n    airline: item.airline || item.carrier || null,\n    flight_number: item.flight_number || item.flight || null,\n    price: item.price || item.total_price || item.price?.value || null,\n    total_duration: item.total_duration || item.duration || item.duration_minutes || null,\n    stops: item.stops ?? item.number_of_stops ?? null,\n    departure_time: item.departure_time || item.departure || null,\n    arrival_time: item.arrival_time || item.arrival || null,\n    provider: 'SerpAPI Google Flights',\n    alert_type: 'SerpAPI flight result'\n  }\n}));"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                320,
                -128
            ],
            "id": "code-1",
            "name": "Normalize SerpAPI Response"
        },
        {
            "parameters": {
                "operation": "append",
                "documentId": {
                    "__rl": true,
                    "value": "GOOGLE_SHEET_ID",
                    "mode": "id"
                },
                "sheetName": {
                    "__rl": true,
                    "value": "gid=0",
                    "mode": "list"
                },
                "columns": {
                    "mappingMode": "defineBelow",
                    "value": {
                        "Airline": "={{$json.airline}}",
                        "Arrival_time": "={{$json.arrival_time}}",
                        "Departure_time": "={{$json.departure_time}}",
                        "Destination": "={{$json.destination}}",
                        "Flight_number": "={{$json.flight_number}}",
                        "Origin": "={{$json.origin}}",
                        "Price": "={{$json.price}}",
                        "Provider": "={{$json.provider}}",
                        "Stops": "={{$json.stops}}",
                        "Timestamp": "={{$now}}",
                        "Total_duration": "={{$json.total_duration}}",
                        "Alert_type": "SerpAPI flight result"
                    },
                    "attemptToConvertTypes": false
                },
                "options": {}
            },
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4.7,
            "position": [
                640,
                96
            ],
            "id": "gs-1",
            "name": "Append row in sheet"
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "version": 3
                    },
                    "conditions": [
                        {
                            "leftValue": "={{ $json.price }}",
                            "rightValue": "=DEFAULT_MAX_PRICE",
                            "operator": {
                                "type": "number",
                                "operation": "lt"
                            }
                        }
                    ]
                }
            },
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.3,
            "position": [
                624,
                -128
            ],
            "id": "if-1",
            "name": "If"
        },
        {
            "parameters": {
                "maxItems": 3
            },
            "type": "n8n-nodes-base.limit",
            "typeVersion": 1,
            "position": [
                832,
                -240
            ],
            "id": "limit-1",
            "name": "Limit"
        },
        {
            "parameters": {
                "chatId": "TELEGRAM_CHAT_ID",
                "text": "=🚨 Cheap Flight (SerpAPI)\n✈ {{$json.airline}} — {{$json.origin}} → {{$json.destination}} — ${{$json.price}}"
            },
            "type": "n8n-nodes-base.telegram",
            "typeVersion": 1.2,
            "position": [
                1008,
                -240
            ],
            "id": "tg-1",
            "name": "Send a text message"
        }
    ],
    "connections": {
        "Schedule Trigger": {
            "main": [
                [
                    {
                        "node": "HTTP Request",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "HTTP Request": {
            "main": [
                [
                    {
                        "node": "Normalize SerpAPI Response",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Normalize SerpAPI Response": {
            "main": [
                [
                    {
                        "node": "If",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "Append row in sheet",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "If": {
            "main": [
                [
                    {
                        "node": "Limit",
                        "type": "main",
                        "index": 0
                    }
                ],
                []
            ]
        },
        "Limit": {
            "main": [
                [
                    {
                        "node": "Send a text message",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "active": false,
    "settings": {
        "executionOrder": "v1",
        "binaryMode": "separate"
    },
    "meta": {
        "note": "Sanitized export for SerpAPI; configure credentials in n8n locally."
    },
    "tags": []
}