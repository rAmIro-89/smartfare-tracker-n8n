{
  "name": "smartfare-tracker-serpapi-wip",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -192,
        -128
      ],
      "id": "sched-1",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "url": "SERPAPI_BASE_URL",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "engine", "value": "SERPAPI_ENGINE" },
            { "name": "api_key", "value": "SERPAPI_API_KEY" },
            { "name": "q", "value": "EZE to YWG" },
            { "name": "output_currency", "value": "DEFAULT_CURRENCY" },
            { "name": "max_price", "value": "DEFAULT_MAX_PRICE" },
            { "name": "max_stops", "value": "DEFAULT_MAX_STOPS" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        80,
        -128
      ],
      "id": "http-1",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const results = $json.results || [];\nreturn results.map(item => ({ json: { timestamp: new Date().toISOString(), origin: 'EZE', destination: 'YWG', airline: item.airline || null, price: item.price?.value || null, currency: item.price?.currency || null, stops: item.stops || null, duration_minutes: item.duration_minutes || null, itinerary: item.itinerary || null, alert_type: 'SerpAPI flight result' } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        -128
      ],
      "id": "code-1",
      "name": "Normalize SerpAPI Response"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "GOOGLE_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "gid=0", "mode": "list" },
        "columns": { "mappingMode": "defineBelow", "value": { "Airline": "={{$json.airline}}", "Price": "={{$json.price}}", "Origin": "={{$json.origin}}", "Destination": "={{$json.destination}}", "Timestamp": "={{$now}}", "Alert_type": "SerpAPI flight result" }, "attemptToConvertTypes": false }
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        640,
        96
      ],
      "id": "gs-1",
      "name": "Append row in sheet"
    },
    {
      "parameters": {
        "conditions": { "options": { "version": 3 }, "conditions": [ { "leftValue": "={{ $json.price }}", "rightValue": "=DEFAULT_MAX_PRICE", "operator": { "type": "number", "operation": "lt" } } ] }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        624,
        -128
      ],
      "id": "if-1",
      "name": "If"
    },
    {
      "parameters": { "maxItems": 3 },
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        832,
        -240
      ],
      "id": "limit-1",
      "name": "Limit"
    },
    {
      "parameters": { "chatId": "TELEGRAM_CHAT_ID", "text": "=🚨 Cheap Flight (SerpAPI)\n✈ {{$json.airline}} — {{$json.origin}} → {{$json.destination}} — ${{$json.price}}" },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1008,
        -240
      ],
      "id": "tg-1",
      "name": "Send a text message"
    }
  ],
  "connections": { "Schedule Trigger": { "main": [ [ { "node": "HTTP Request", "type": "main", "index": 0 } ] ] }, "HTTP Request": { "main": [ [ { "node": "Normalize SerpAPI Response", "type": "main", "index": 0 } ] ] }, "Normalize SerpAPI Response": { "main": [ [ { "node": "If", "type": "main", "index": 0 }, { "node": "Append row in sheet", "type": "main", "index": 0 } ] ] }, "If": { "main": [ [ { "node": "Limit", "type": "main", "index": 0 } ], [] ] }, "Limit": { "main": [ [ { "node": "Send a text message", "type": "main", "index": 0 } ] ] } },
  "active": false,
  "settings": { "executionOrder": "v1", "binaryMode": "separate" },
  "meta": { "note": "Sanitized export for SerpAPI; configure credentials in n8n locally." },
  "tags": []
}