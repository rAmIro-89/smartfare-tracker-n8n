    {
      "parameters": {
        "jsCode": "const bestFlights = $json.best_flights || [];\nconst otherFlights = $json.other_flights || [];\nconst allFlights = [...bestFlights, ...otherFlights];\n\nreturn allFlights.map(option => {\n  const segments = option.flights || [];\n  const firstSegment = segments[0] || {};\n  const lastSegment = segments[segments.length - 1] || {};\n\n  return {\n    json: {\n      timestamp: new Date().toISOString(),\n      provider: 'SerpAPI Google Flights',\n      origin: firstSegment.departure_airport?.id || null,\n      destination: lastSegment.arrival_airport?.id || null,\n      airline: firstSegment.airline || null,\n      flight_number: firstSegment.flight_number || null,\n      departure_time: firstSegment.departure_airport?.time || null,\n      arrival_time: lastSegment.arrival_airport?.time || null,\n      total_duration: option.total_duration || null,\n      stops: segments.length > 0 ? segments.length - 1 : null,\n      price: option.price || null,\n      currency: 'USD',\n      alert_type: 'Real fare search result'\n    }\n  };\n});"
      },
