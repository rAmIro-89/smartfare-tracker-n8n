      "parameters": {
        "jsCode": "const bestFlights = $json.best_flights || [];\nconst otherFlights = $json.other_flights || [];\n\nconst allFlights = [...bestFlights, ...otherFlights];\n\nreturn allFlights.map(option => {\n  const segments = option.flights || [];\n  const firstSegment = segments[0] || {};\n  const lastSegment = segments[segments.length - 1] || {};\n\n  return {\n    json: {\n      timestamp: new Date().toISOString(),\n      provider: \"SerpAPI Google Flights\",\n      origin: firstSegment.departure_airport?.id || null,\n      destination: lastSegment.arrival_airport?.id || null,\n      airline: firstSegment.airline || null,\n      flight_number: firstSegment.flight_number || null,\n      departure_time: firstSegment.departure_airport?.time || null,\n      arrival_time: lastSegment.arrival_airport?.time || null,\n      duration_minutes: option.total_duration || null,\n      stops: segments.length > 0 ? segments.length - 1 : null,\n      price: option.price || null,\n      currency: \"USD\",\n      alert_type: \"Real fare search result\"\n    }\n  };\n});;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        -192
      ],
      "id": "356875d4-185c-4830-b5ff-0299ea99ae3b",
      "name": "Normalize SerAPI Response"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const flight = item.json;\n\n  let score = 100;\n  const reasons = [];\n  const pros = [];\n  const cons = [];\n\n  if (flight.price > 900) {\n    score -= 40;\n    reasons.push(\"Price above preferred budget\");\n    cons.push(\"Price > 900 USD\");\n  } else if (flight.price <= 750) {\n    reasons.push(\"Excellent price\");\n    pros.push(\"Price < 750 USD\");\n  } else {\n    reasons.push(\"Price within budget\");\n    pros.push(\"Price <= 900 USD\");\n  }\n\n  if (flight.stops > 2) {\n    score -= 20;\n    reasons.push(\"Too many stops\");\n    cons.push(\"Stops > 2\");\n  } else {\n    pros.push(\"Stops within limit\");\n  }\n\n  if (flight.duration_minutes > 1500) {\n    score -= 30;\n    reasons.push(\"Duration exceeds preferred maximum\");\n    cons.push(\"Duration > 1500 min\");\n  } else {\n    pros.push(\"Duration within limit\");\n  }\n\n  score = Math.max(0, Math.min(100, score));\n\n  return {\n    json: {\n      ...flight,\n      score,\n      alert: score >= 75,\n      reason: reasons.join(\"; \"),\n      pros,\n      cons,\n      scoring_reasons: reasons\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
